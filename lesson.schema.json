{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfanals/recallforge/raw/main/lesson.schema.json",
  "title": "RecallForge lesson",
  "type": "object",
  "required": ["title", "source", "narrator_language", "target_language", "segments"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "narrator_language": {"$ref": "#/$defs/language"},
    "target_language": {"$ref": "#/$defs/language"},
    "goals": {"type": "array", "items": {"type": "string"}},
    "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "language": {"enum": ["en-US", "en-GB", "es", "fr-FR", "hi", "it", "ja", "pt-BR", "zh-CN"]},
    "segment": {
      "type": "object",
      "required": ["id", "chapter", "kind", "language", "voice", "text", "gap_after_seconds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "chapter": {"type": "string", "minLength": 1},
        "kind": {"enum": ["instruction", "dialogue", "model", "repeat_model", "confirmation", "recall_prompt", "assessment_prompt", "free_response_prompt"]},
        "language": {"$ref": "#/$defs/language"},
        "voice": {"type": "string", "minLength": 2},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000},
        "gap_after_seconds": {"type": "number", "minimum": 0, "maximum": 120},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2},
        "expected_answer": {"type": "string", "minLength": 1},
        "acceptable_variants": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{"if": {"properties": {"kind": {"enum": ["recall_prompt", "assessment_prompt"]}}}, "then": {"required": ["expected_answer"]}}]
    }
  }
}
